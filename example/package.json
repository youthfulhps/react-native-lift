{
  "name": "react-native-lift-example",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@react-navigation/native": "^7.5.1",
    "@shopify/flash-list": "2.3.3",
    "expo": "~58.0.17",
    "expo-blur": "~58.0.5",
    "expo-dev-client": "~58.0.14",
    "expo-haptics": "~58.0.7",
    "expo-video": "~58.0.12",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-teleport": "1.2.2",
    "react-native-video": "6.19.3",
    "react-native-worklets": "0.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
